 /**
+  True iff the LOAD DATA field list is the table's full column set in natural
+  order (no column list given, or an explicit identity list) with no user
+  variables — i.e. CSV field i maps to table column i. Required for the engine
+  bulk-load fast-path, which ingests the file positionally.
+*/
+static bool ducksdb_is_identity_field_list(const mem_root_deque<Item *> &fields,
+                                           const TABLE *table) {
+  if (fields.size() != table->s->fields) return false;
+  uint i = 0;
+  for (Item *it : fields) {
+    if (it == nullptr || it->type() != Item::FIELD_ITEM) return false;
+    const Field *f = down_cast<const Item_field *>(it)->field;
+    if (f == nullptr || f->field_index() != i) return false;
+    ++i;
+  }
+  return true;
+}
