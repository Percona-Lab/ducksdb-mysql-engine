+/**
+  select_handler-style pushdown helper: return the common handlerton iff every
+  base (leaf) table of the query block belongs to the SAME storage engine and
+  there is at least one base table; otherwise nullptr. Used to offer whole-query
+  pushdown to an engine (e.g. ENGINE=DuckDB) that implements
+  handlerton::pushdown_select.
+*/
+static const handlerton *single_engine_for_pushdown(const Query_block *qb) {
+  const handlerton *common = nullptr;
+  int n = 0;
+  for (Table_ref *tr = qb->leaf_tables; tr != nullptr; tr = tr->next_leaf) {
+    const handlerton *ht = nullptr;
+    if (tr->is_derived()) {
+      // Look THROUGH a (materialized) derived table: its inner query block(s)
+      // must themselves resolve to the same single pushdown engine. Without this
+      // the helper bailed on any derived table, so the pushdown_select hook was
+      // never offered for a query whose FROM contains an inline view, even when
+      // every underlying base table is that engine.
+      Query_expression *u = tr->derived_query_expression();
+      if (u == nullptr) return nullptr;
+      for (Query_block *sb = u->first_query_block(); sb != nullptr;
+           sb = sb->next_query_block()) {
+        const handlerton *sub = single_engine_for_pushdown(sb);  // recurse
+        if (sub == nullptr) return nullptr;
+        if (ht == nullptr)
+          ht = sub;
+        else if (ht != sub)
+          return nullptr;  // mixed engines inside the derived table
+      }
+      if (ht == nullptr) return nullptr;  // empty derived: bail
+    } else {
+      if (tr->table == nullptr || tr->table->file == nullptr)
+        return nullptr;  // not a plain base table
+      ht = tr->table->file->ht;
+    }
+    if (common == nullptr)
+      common = ht;
+    else if (common != ht)
+      return nullptr;  // mixed engines
+    ++n;
+  }
+  return n > 0 ? common : nullptr;
+}
